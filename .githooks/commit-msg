#!/bin/sh
# Enforces Conventional Commits. See CONTRIBUTING.md.

msg_file="$1"
first_line="$(head -n 1 "$msg_file")"

# Allow git-generated merge and revert messages.
if echo "$first_line" | grep -Eq '^(Merge|Revert) '; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$'

if ! echo "$first_line" | grep -Eq "$pattern"; then
  echo "ERROR: commit message does not follow Conventional Commits."
  echo "  Got:      $first_line"
  echo "  Expected: <type>(<scope>): <summary of at most 72 chars>"
  echo "  Types:    feat fix docs style refactor perf test build ci chore revert"
  exit 1
fi

exit 0
